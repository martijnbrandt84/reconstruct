{
  "manifest_version": 3,
  "name": "Reconstruct – liveblog toevoegen",
  "version": "1.3.3",
  "description": "Voegt de liveblog in het huidige tabblad met één klik toe aan Reconstruct en ververst toegevoegde liveblogs.",
  "action": {
    "default_title": "Liveblog toevoegen aan Reconstruct",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:8777/*", "http://127.0.0.1:8777/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8777/*",
    "http://127.0.0.1:8777/*",
    "https://*.nu.nl/*",
    "https://nos.nl/*",
    "https://*.nos.nl/*",
    "https://*.nrc.nl/*",
    "https://*.ad.nl/*",
    "https://*.volkskrant.nl/*",
    "https://*.trouw.nl/*",
    "https://*.parool.nl/*",
    "https://*.rtl.nl/*",
    "https://*.rtlnieuws.nl/*",
    "https://*.telegraaf.nl/*",
    "https://*.hln.be/*",
    "https://*.demorgen.be/*",
    "https://*.bd.nl/*",
    "https://*.bndestem.nl/*",
    "https://*.gelderlander.nl/*",
    "https://*.ed.nl/*",
    "https://*.pzc.nl/*",
    "https://*.destentor.nl/*",
    "https://*.tubantia.nl/*",
    "https://fd.nl/*",
    "https://*.fd.nl/*"
  ]
}
